% mystyle.sty
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mystyle}[2026/06/08 My Custom Style Package]

% ==========================================
% 1. 加载必要的宏包
% ==========================================
\RequirePackage{geometry}      % 页面布局
\RequirePackage{xcolor}        % 颜色定义
\RequirePackage{fancyhdr}      % 页眉页脚
% \RequirePackage{ctex}        % 中文支持（由 ctexart 文档类提供）
% 使用 ctex 原生标题配置，避免 titlesec 与 hyperref 的跨页锚点冲突。
\RequirePackage[hidelinks]{hyperref} % 超链接

% ==========================================
% 2. 定义全局颜色变量
% ==========================================
\definecolor{PrimaryColor}{HTML}{2C3E50}
\definecolor{AccentColor}{HTML}{E74C3C}
\definecolor{LightGray}{HTML}{F5F5F5}

% ==========================================
% 3. 页面布局设置
% ==========================================
\geometry{
    a4paper,
    top=2.5cm,
    bottom=2.5cm,
    left=3cm,
    right=2.5cm,
    headheight=14pt
}

% ==========================================
% 4. 标题样式定制
% ==========================================
\ctexset{
  section = {
    format = \Large\bfseries\raggedright\color{PrimaryColor},
    aftername = \hspace{1em}
  },
  subsection = {
    format = \large\bfseries\raggedright\color{PrimaryColor!80},
    aftername = \hspace{1em}
  },
  subsubsection = {
    format = \normalsize\bfseries\raggedright\color{PrimaryColor!60},
    aftername = \hspace{1em}
  }
}

% ==========================================
% 5. 页眉页脚
% ==========================================
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\textcolor{gray}{\leftmark}}
\fancyhead[R]{\small\textcolor{gray}{My Document}}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0.5pt}

% ==========================================
% 6. 自定义命令/环境
% ==========================================
\newcommand{\highlight}[1]{%
  \colorbox{LightGray}{\padding{3pt}{#1}}%
}

\newenvironment{notebox}{%
  \begin{quote}\itshape\color{AccentColor}%
}{%
  \end{quote}%
}

\endinput
